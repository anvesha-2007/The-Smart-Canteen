{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered student or canteen administrator profile",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "minLength": 6,
          "maxLength": 20
        },
        "studentId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["student", "admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "name", "email", "phone", "studentId", "department", "role", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Verified canteen administrator access record",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "name", "createdAt"]
    },
    "FoodItem": {
      "title": "FoodItem",
      "description": "Canteen menu item with pricing in INR and availability",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 400
        },
        "category": {
          "type": "string",
          "enum": ["Breakfast", "Snacks", "Meals", "Beverages", "Desserts"]
        },
        "price": {
          "type": "number"
        },
        "imageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "available": {
          "type": "boolean"
        },
        "isPopular": {
          "type": "boolean"
        },
        "isSpecial": {
          "type": "boolean"
        },
        "isVeg": {
          "type": "boolean"
        },
        "prepTimeMinutes": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "description",
        "category",
        "price",
        "imageUrl",
        "available",
        "isPopular",
        "isSpecial",
        "isVeg",
        "prepTimeMinutes",
        "createdAt",
        "updatedAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "Student canteen order with Cash at Counter payment and live status tracking",
      "type": "object",
      "properties": {
        "orderNumber": {
          "type": "string",
          "minLength": 6,
          "maxLength": 32,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "customerEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 120
        },
        "customerPhone": {
          "type": "string",
          "minLength": 6,
          "maxLength": 20
        },
        "studentId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "pickupNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "items": {
          "type": "array"
        },
        "subtotal": {
          "type": "number"
        },
        "totalAmount": {
          "type": "number"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["Cash at Counter"]
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Preparing", "Ready", "Completed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "orderNumber",
        "userId",
        "customerName",
        "customerEmail",
        "customerPhone",
        "studentId",
        "pickupNote",
        "items",
        "subtotal",
        "totalAmount",
        "paymentMethod",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Private user profiles storing student/admin details"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted registry of verified canteen administrators"
    },
    "/foodItems/{foodId}": {
      "schema": { "$ref": "#/entities/FoodItem" },
      "description": "Canteen menu catalog items"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Student orders placed for Cash at Counter pickup"
    }
  }
}
